{#
/**
 * @file
 * Default theme implementation for the status report general info.
 *
 * Available variables:
 * - properties: A list of information about the site:
 *   - label: A short title.
 *   - description: Description of the property.
 *   - view: A display of the property. May include a render array.
 */
#}

<h2>{{ 'General System Information'|t }}</h2>

<div class="system-status-general-info>
{% for property in properties %}
  <div class="system-status-general-info__item">
    <h3 class="system-status-general-info__item-title">{{ property.label }}</h3>
    {{ property.view }}
  </div>
{% endfor %}
</div>
