{#
/**
 * @file
 * Theme override for multiple field items without drag-and-drop reordering.
 *
 * This template is used when the field widget's 'orderable' setting is FALSE,
 * providing a simpler non-table layout without drag-and-drop functionality.
 *
 * Available variables for all fields:
 * - multiple: Whether there are multiple instances of the field.
 *
 * Available variables for single cardinality fields:
 * - elements: Form elements to be rendered.
 *
 * Available variables when there are multiple fields:
 * - items: Rendered field items (without table/tabledrag).
 * - title: The field label.
 * - title_attributes: HTML attributes to apply to the title element.
 * - required: Whether the field is required.
 * - description: The description element containing the following properties:
 *   - content: The description content of the form element.
 *   - attributes: HTML attributes to apply to the description container.
 * - button: "Add another item" button.
 *
 * @see \Drupal\Core\Field\WidgetBase::formMultipleElements()
 */
#}
{%
  set classes = [
    'js-form-item',
    'form-item',
  ]
%}
{%
  set title_classes = [
    'label',
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
{% if multiple %}
  {% if title %}
    <h4{{ title_attributes.addClass(title_classes) }}>{{ title }}</h4>
  {% endif %}
  <div{{ attributes.addClass(classes) }}>
    {% for item in items %}
      <div class="field-multiple-item container-inline">
        {{ item }}
      </div>
    {% endfor %}
    {% if description.content %}
      <div{{ description.attributes.addClass('description') }}>{{ description.content }}</div>
    {% endif %}
    {% if button %}
      <div class="clearfix">{{ button }}</div>
    {% endif %}
  </div>
{% else %}
  {% for element in elements %}
    {{ element }}
  {% endfor %}
{% endif %}
