{# cspell:ignore closedby #}
{# cspell:ignore closerequest #}

{# Setup base attributes #}
{# Additional classes will be set by variant. #}
{% set attributes = create_attribute({
  class: ['ui-dialog', 'ui-widget', 'ui-front'],
  'aria-labelledby': (id ~ '-title'),
 })
%}

{# Setup content wrapper attributes #}
{# Additional classes will be set by variant. #}
{% set content_wrapper_attributes = create_attribute({
    class: ['dialog-content', 'ui-dialog-content'],
  })
%}

<drupal-dialog id="{{ id }}">
  {% if variant === 'off-canvas' %}
  {# Off canvas dialogs are in the layout and use a wrapper <div> #}
  <div id="drupal-off-canvas-wrapper" role="dialog" aria-describedby="drupal-off-canvas" {{ attributes.addClass([
  'dialog-off-canvas',
  'dialog-position-' ~ position ?? 'side',
  'ui-dialog-off-canvas',
  'ui-dialog-position-' ~ position ?? 'side',
  ]).addClass(dialog_classes) }}>
  {% else %}
    {# Setup default and modal dialog attributes #}
    {% set close = 'closerequest' %}
    {% if variant === 'default' %}
      {% set close = 'any' %}
      {% set content_id = 'drupal-dialog' %}
    {% endif %}
    {% if variant === 'modal' %}
      {% set content_id = 'drupal-modal' %}
    {% endif %}
    {# Dialogs are in the top layer so use a native <dialog> #}
    <dialog open aria-labelledby="{{ id -}}-title" closedby="{{ close }}" {% if variant === 'modal' %} data-modal{% endif %} {{ attributes.addClass('ui-widget-content').addClass(dialog_classes) }}>
  {% endif %}
    <div class="titlebar ui-dialog-titlebar">
      <h2 id="{{ id -}}-title" class="dialog-title ui-dialog-title">{{ title }}</h2>
      <form method="dialog">
        <button class="titlebar-close ui-dialog-titlebar-close" aria-label="Close">
          <span class="ui-button-icon ui-icon ui-icon-closethick"></span>
          <span class="ui-button-icon-space"> </span>
          Close
        </button>
      </form>
    </div>
    {% if variant === 'off-canvas' %}
    <div id="drupal-off-canvas" {{ content_wrapper_attributes.addClass('drupal-off-canvas-reset') }}>
    {% else %}
    <div {{ content_wrapper_attributes }}>
    {% endif %}
    {% block content %}
      {{ content }}
    {% endblock %}
    </div>
  {% if variant === 'off-canvas' %}
  </div>
  {% else %}
  </dialog>
  {% endif %}
</drupal-dialog>
