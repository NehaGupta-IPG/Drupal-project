{#
/**
 * @file
 * Test templates file with extra messages div.
 */
#}
<div data-drupal-messages>
{% block messages %}
{% for type, messages in message_list %}
  {%
    set classes = [
      'messages',
      'messages--' ~ type,
    ]
  %}
  <div role="{{ type in ['error', 'warning'] ? 'alert' : 'status' }}" aria-label="{{ status_headings[type] }}"{{ attributes.addClass(classes)|without('role', 'aria-label') }} data-drupal-message-set>
    {% if status_headings[type] %}
      <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
    {% endif %}
      <ul class="messages__list" data-drupal-message-list-type="{{ type }}">
        {%- for message in messages %}
          {% message.attributes.addClass('messages__item') %}
          {{ message }}
        {%- endfor -%}
      </ul>
  </div>
  {# Remove type specific classes. #}
  {% set attributes = attributes.removeClass(classes) %}
{% endfor %}
{% endblock messages %}
</div>
<div data-drupal-messages-other></div>
