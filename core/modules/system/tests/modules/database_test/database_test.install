<?php

/**
 * @file
 * Install, update and uninstall functions for the database_test module.
 */

declare(strict_types=1);

use Drupal\Core\Database\SchemaDefinition\Column;
use Drupal\Core\Database\SchemaDefinition\ColumnType;
use Drupal\Core\Database\SchemaDefinition\Index;
use Drupal\Core\Database\SchemaDefinition\IntValue;
use Drupal\Core\Database\SchemaDefinition\PrimaryKey;
use Drupal\Core\Database\SchemaDefinition\Schema;
use Drupal\Core\Database\SchemaDefinition\StringValue;
use Drupal\Core\Database\SchemaDefinition\Table;
use Drupal\Core\Database\SchemaDefinition\UniqueKey;

/**
 * Implements hook_schema().
 *
 * The database tests use the database API which depends on schema
 * information for certain operations on certain databases.
 * Therefore, the schema must actually be declared in a normal module
 * like any other, not directly in the test file.
 */
function database_test_schema(): Schema {
  $test_table = new Table(
    name: 'test',
    description: 'Basic test table for the database unit tests.',
    columns: [
      new Column(
        name: 'id',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        binary: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue('Undefined'),
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
    uniqueKeys: [
      new UniqueKey(name: 'name', columns: ['name']),
    ],
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  $test_classtype_table = new Table(
    name: 'test_classtype',
    description: 'A duplicate version of the test table, used for obsolete fetch_style PDO::FETCH_CLASSTYPE tests.',
    columns: [
      new Column(
        name: 'classname',
        description: "A custom class name",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
    ],
    primaryKey: new PrimaryKey(['job']),
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  // This is an alternate version of the same table that is structured the same
  // but has a non-serial Primary Key.
  $test_people_table = new Table(
    name: 'test_people',
    description: 'A duplicate version of the test table, used for additional tests.',
    columns: [
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
    ],
    primaryKey: new PrimaryKey(['job']),
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  $test_people_copy_table = new Table(
    name: 'test_people_copy',
    description: 'A duplicate version of the test_people table, used for additional tests.',
    columns: [
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
    ],
    primaryKey: new PrimaryKey(['job']),
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  $test_one_blob_table = new Table(
    name: 'test_one_blob',
    description: 'A simple table including a BLOB field for testing BLOB behavior.',
    columns: [
      new Column(
        name: 'id',
        description: 'Simple unique ID.',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'blob1',
        description: 'A BLOB field.',
        type: ColumnType::Blob,
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
  );

  $test_two_blobs_table = new Table(
    name: 'test_two_blobs',
    description: 'A simple test table with two BLOB fields.',
    columns: [
      new Column(
        name: 'id',
        description: 'Simple unique ID.',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'blob1',
        description: 'A dummy BLOB field.',
        type: ColumnType::Blob,
      ),
      new Column(
        name: 'blob2',
        description: 'A second BLOB field.',
        type: ColumnType::Blob,
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
  );

  $test_task_table = new Table(
    name: 'test_task',
    description: 'A task list for people in the test table.',
    columns: [
      new Column(
        name: 'tid',
        description: 'Task ID, primary key.',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'pid',
        description: 'The {test_people}.pid, foreign key for the test table.',
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'task',
        description: 'The task to be completed.',
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'priority',
        description: 'The priority of the task.',
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
    ],
    primaryKey: new PrimaryKey(['tid']),
  );

  $test_null_table = new Table(
    name: 'test_null',
    description: 'Basic test table for NULL value handling.',
    columns: [
      new Column(
        name: 'id',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: FALSE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: FALSE,
        default: new IntValue(0),
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
    uniqueKeys: [
      new UniqueKey(name: 'name', columns: ['name']),
    ],
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  $test_serialized_table = new Table(
    name: 'test_serialized',
    description: 'Basic test table for NULL value handling.',
    columns: [
      new Column(
        name: 'id',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: FALSE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'info',
        description: "The person's data in serialized form.",
        type: ColumnType::Blob,
        serialize: TRUE,
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
    uniqueKeys: [
      new UniqueKey(name: 'name', columns: ['name']),
    ],
  );

  $test_composite_primary_table = new Table(
    name: 'test_composite_primary',
    description: 'Basic test table with a composite primary key',
    columns: [
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::Varchar,
        length: 50,
        notNull: TRUE,
        binary: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue('Undefined'),
      ),
    ],
    primaryKey: new PrimaryKey(['name', 'age']),
  );

  // Hopefully no-one will ever name a table 'select' but this example is a
  // reserved keyword in all supported SQL databases so it is a good test.
  $select_table = new Table(
    name: 'select',
    description: 'A test table with an ANSI reserved keyword as its name and one of its column names.',
    columns: [
      new Column(
        name: 'id',
        description: 'Simple unique ID.',
        // Using a serial as an ID properly tests
        // \Drupal\pgsql\Driver\Database\pgsql\Upsert.
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'update',
        description: 'A column with reserved name.',
        type: ColumnType::Text,
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
  );

  $virtual_table = new Table(
    name: 'virtual',
    description: 'A simple table with reserved name in MySQL 8.',
    columns: [
      new Column(
        name: 'id',
        description: 'Simple unique ID.',
        type: ColumnType::Int,
        notNull: TRUE,
      ),
      new Column(
        name: 'function',
        description: 'A column with reserved name in MySQL 8.',
        type: ColumnType::Text,
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
  );

  $uppercase_test_table = new Table(
    name: 'TEST_UPPERCASE',
    description: 'Basic test table for the database unit tests.',
    columns: [
      new Column(
        name: 'id',
        type: ColumnType::Serial,
      ),
      new Column(
        name: 'name',
        description: "A person's name",
        type: ColumnType::VarcharAscii,
        length: 255,
        notNull: TRUE,
        binary: TRUE,
        default: new StringValue(''),
      ),
      new Column(
        name: 'age',
        description: "The person's age",
        type: ColumnType::Int,
        unsigned: TRUE,
        notNull: TRUE,
        default: new IntValue(0),
      ),
      new Column(
        name: 'job',
        description: "The person's job",
        type: ColumnType::Varchar,
        length: 255,
        notNull: TRUE,
        default: new StringValue('Undefined'),
      ),
    ],
    primaryKey: new PrimaryKey(['id']),
    uniqueKeys: [
      new UniqueKey(name: 'name', columns: ['name']),
    ],
    indexes: [
      new Index(name: 'ages', columns: ['age']),
    ],
  );

  return new Schema(
    name: 'database_test',
    tables: [
      $test_table,
      $test_classtype_table,
      $test_people_table,
      $test_people_copy_table,
      $test_one_blob_table,
      $test_two_blobs_table,
      $test_task_table,
      $test_null_table,
      $test_serialized_table,
      $test_composite_primary_table,
      $uppercase_test_table,
      $select_table,
      $virtual_table,
    ],
  );
}
