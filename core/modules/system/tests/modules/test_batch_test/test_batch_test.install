<?php

/**
 * @file
 * Install hooks for test module.
 */

declare(strict_types=1);

use Drupal\Core\Batch\BatchManagerInterface;
use Drupal\entity_test\Entity\EntityTest;

/**
 * Implements hook_install().
 */
function test_batch_test_install(): void {
  $batch_manager = \Drupal::service(BatchManagerInterface::class);
  $total = 2;
  $operations = [];
  for ($i = 1; $i <= $total; $i++) {
    $operations[] = ['_test_batch_test_callback', [$i]];
  }
  $batch = [
    'operations' => $operations,
  ];
  $batch_manager->addBatch($batch);
  // Bypass the progress bar and the redirect: the batch has to complete within
  // this request.
  $batch_manager->setProgressive(FALSE);
  $batch_manager->process();
}

/**
 * Callback for batch operations.
 */
function _test_batch_test_callback($id): void {
  $entity = EntityTest::create(['id' => $id]);
  $entity->save();
}
