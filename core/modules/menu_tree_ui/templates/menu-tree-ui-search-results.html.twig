{#
/**
 * @file
 * Search results — swapped into the popover by htmx.
 *
 * The response is a whole page, and htmx keeps only what the input's hx-select
 * picks: the children of the element marked data-mtu-search-results.
 *
 * Variables:
 * - results: list of { id, title, enabled, edit_url, breadcrumb: string[], breadcrumb_ids: string[] }
 * - query:   the search string
 *
 * UX contract: an empty query renders an empty wrapper. The popover (which targets
 * #menu-tree-ui-search-results) hides itself via `:not(:has(*))` when there
 * are no element children, so the input is "closed" until the user types.
 *
 * Each result's title is rendered as a button that dispatches a "jump to"
 * action to the tree: walk the ancestor chain (breadcrumb_ids), expand each
 * level in turn, then scroll/focus the target row. The JS handler lives in
 * js/jump-to.js and listens at document level for clicks on
 * [data-mtu-jump-id] so it works even though search results are htmx-injected.
 */
#}
<div data-mtu-search-results>
{% if query is not empty %}
  {% if results is empty %}
    <p class="menu-tree-ui-search-results__empty">
      {{ 'No matches for "@q".'|t({'@q': query}) }}
    </p>
  {% else %}
    <p class="menu-tree-ui-search-results__summary">
      {% trans %}
        1 result for "{{ query }}"
      {% plural results|length %}
        @count results for "{{ query }}"
      {% endtrans %}
    </p>
    <ul class="menu-tree-ui-search-results__list">
      {% for result in results %}
        <li class="menu-tree-ui-search-results__item {{ result.enabled ? '' : 'menu-tree-ui-search-results__item--disabled' }}">
          <button
            type="button"
            class="menu-tree-ui-search-results__title"
            data-mtu-jump-id="{{ result.id }}"
            data-mtu-jump-path="{{ result.breadcrumb_ids|join(',') }}"
            title="{{ 'Reveal in tree'|t }}"
          >{{ result.title }}</button>
          {% if result.breadcrumb is not empty %}
            <div class="menu-tree-ui-search-results__breadcrumb">
              {{ result.breadcrumb|join(' › ') }}
            </div>
          {% endif %}
          {% if result.edit_url %}
            <a class="menu-tree-ui-search-results__edit" href="{{ result.edit_url }}">{{ 'Edit'|t }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endif %}
</div>
