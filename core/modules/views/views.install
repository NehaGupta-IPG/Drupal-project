<?php

/**
 * @file
 * Contains install and update functions for Views.
 */

/**
 * Implements hook_update_last_removed().
 */
function views_update_last_removed(): int {
  return 11201;
}

/**
 * Reset views module weight.
 */
function views_update_11202(): void {
  if (\Drupal::configFactory()->getEditable('core.extension')->get('module.views') == 10) {
    module_set_weight('views', 0);
  }
}
