<?php

/**
 * @file
 * Contains install and update functions for Layout Builder.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\layout_builder\Entity\LayoutBuilderEntityViewDisplay;
use Drupal\layout_builder\Section;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function layout_builder_install(): void {
  $display_changed = FALSE;

  $displays = LayoutBuilderEntityViewDisplay::loadMultiple();
  /** @var \Drupal\layout_builder\Entity\LayoutEntityDisplayInterface[] $displays */
  foreach ($displays as $display) {
    // Create the first section from any existing Field Layout settings.
    $field_layout = $display->getThirdPartySettings('field_layout');
    if (isset($field_layout['id'])) {
      $field_layout += ['settings' => []];
      $display
        ->enableLayoutBuilder()
        ->appendSection(new Section($field_layout['id'], $field_layout['settings']))
        ->save();
      $display_changed = TRUE;
    }
  }

  // Clear the rendered cache to ensure the new layout builder flow is used.
  // While in many cases the above change will not affect the rendered output,
  // the cacheability metadata will have changed and should be processed to
  // prepare for future changes.
  if ($display_changed) {
    Cache::invalidateTags(['rendered']);
  }
}

/**
 * Implements hook_schema().
 */
function layout_builder_schema(): array {
  $schema['inline_block_usage'] = [
    'description' => 'Track where a block_content entity is used.',
    'fields' => [
      'block_content_id' => [
        'description' => 'The block_content entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'layout_entity_type' => [
        'description' => 'The entity type of the parent entity.',
        'type' => 'varchar_ascii',
        'length' => EntityTypeInterface::ID_MAX_LENGTH,
        'not null' => FALSE,
        'default' => '',
      ],
      'layout_entity_id' => [
        'description' => 'The ID of the parent entity.',
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => FALSE,
        'default' => 0,
      ],
    ],
    'primary key' => ['block_content_id'],
    'indexes' => [
      'type_id' => ['layout_entity_type', 'layout_entity_id'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_update_last_removed().
 */
function layout_builder_update_last_removed(): int {
  return 8602;
}

/**
 * Add the 'revert {bundle} {entityTypeId} to default layout' permission.
 */
function layout_builder_update_11200(): void {
  // Get all layouts with overrides enabled.
  $displays = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->loadByProperties(['third_party_settings.layout_builder.allow_custom' => TRUE]);
  if (!$displays) {
    // No custom overrides, nothing to do.
    return;
  }
  $rolesToSave = [];
  $roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple();
  $rolesPermissions = \array_map(static fn (Role $role) => $role->getPermissions(), $roles);
  foreach ($displays as $display) {
    /** @var \Drupal\layout_builder\Entity\LayoutEntityDisplayInterface $display */
    if (!$display->isOverridable()) {
      // This should always be true, but just in case.
      continue;
    }
    // Check if any role has the
    // 'configure all $bundle $entityTypeId layout overrides' permission.
    $entityTypeId = $display->getTargetEntityTypeId();
    $bundle = $display->getTargetBundle();
    $layoutPermissions = [
      \sprintf('configure all %s %s layout overrides', $bundle, $entityTypeId),
      \sprintf('configure editable %s %s layout overrides', $bundle, $entityTypeId),
    ];
    foreach ($rolesPermissions as $rid => $permissions) {
      // Use array_intersect to check if any of the permissions exist.
      if (!\array_intersect($permissions, $layoutPermissions)) {
        continue;
      }
      $role = $roles[$rid];
      // Add the new permission.
      $new_permission = \sprintf('revert %s %s to default layout', $bundle, $entityTypeId);
      if (!$role->hasPermission($new_permission)) {
        $role->grantPermission($new_permission);
        $rolesToSave[$rid] = $role;
      }
    }
  }
  // Save all roles that were modified.
  foreach ($rolesToSave as $role) {
    $role->save();
  }
}
