{#
/**
 * @file
 * Default theme implementation to render user email.
 *
 * Available variables:
 * - id: The email id.
 * - module: Machine name of the email sending module.
 * - key: Machine name used to identify emails sent from the same module.
 * - langcode: The language code.
 * - email: The email instance.
 *
 * Available variables specific to user mails:
 * - account: The user entity with limited access to object properties and
 *   methods. Only method names starting with "get", "has", or "is" and a few
 *   common methods such as "id", "label", and "bundle" are available. For
 *   example:
 *   - account.getDisplayName() will return the users display name.
 *   - account.hasField('field_example') returns TRUE if the user bundle
 *     includes field_example. (This does not indicate the presence of a value
 *     in this field.)
 *   - account.isActive() will return whether the user account is active or not.
 * - confirm_url: A fully qualified URL to confirm an action, e.g., for emails
 *   such as password reset or user cancelation requests.
 *
 * Available slots:
 * - content: All content items generated by the email builder. Use
 *   {{ content }} to print them all, or print a subset such as
 *   {{ content.field_example }}. Use {{ content|without('field_example') }} to
 *   temporarily suppress the printing of a given child element.
 *
 * @see \Drupal\mailer\Hook\MailerThemeHooks::preprocessEmail()
 * @see \Drupal\mailer\Hook\MailerThemeHooks::themeSuggestionsEmail()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes }}>
  {{ content }}
</div>
