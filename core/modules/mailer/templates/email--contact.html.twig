{#
/**
 * @file
 * Default theme implementation to render contact email.
 *
 * Available variables:
 * - id: The email id.
 * - module: Machine name of the email sending module.
 * - key: Machine name used to identify emails sent from the same module.
 * - langcode: The language code.
 * - email: The email instance.
 *
 * Available variables specific to contact mails:
 * - message: The contact message entity with limited access to object
 *   properties and methods. Only method names starting with "get", "has", or
 *   "is" and a few common methods such as "id", "label", and "bundle" are
 *   available. For example:
 *   - message.getSenderName() will return the sender display name.
 *   - message.hasField('field_example') returns TRUE if the message bundle
 *     includes field_example. (This does not indicate the presence of a value
 *     in this field.)
 *   - message.isPersonal() will return whether this message was sent via the
 *     personal contact form or not.
 *
 * Available slots:
 * - content: All content items generated by the email builder. Use
 *   {{ content }} to print them all, or print a subset such as
 *   {{ content.field_example }}. Use {{ content|without('field_example') }} to
 *   temporarily suppress the printing of a given child element.
 *
 * Available content items specific to contact mails:
 * - content.opening: The opening of personal contact messages.
 * - content.intro: Short intro text indicating that this message was generated
 *   by a contact form.
 * - content.opt_out: The opt-out text of personal contact messages.
 * - content.message: The message text.
 *
 * Available content items specific to the contact autoreply:
 * - content.autoreply: The autoreply message.
 *
 * @see \Drupal\mailer\Hook\MailerThemeHooks::preprocessEmail()
 * @see \Drupal\mailer\Hook\MailerThemeHooks::themeSuggestionsEmail()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes }}>
  {{ content }}
</div>
