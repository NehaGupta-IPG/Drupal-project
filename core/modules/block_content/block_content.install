<?php

/**
 * @file
 * Install, update and uninstall functions for the block_content module.
 */
 use Drupal\language\Entity\ContentLanguageSettings;

/**
 * Implements hook_update_last_removed().
 */
function block_content_update_last_removed(): int {
  return 10300;
}

/**
 * Implements_hook_update_N().
 */
function block_content_update_11100() : void {
  if (!\Drupal::moduleHandler()->moduleExists('content_translation')) {
    return;
  }
  
  $permission = 'translate block_content';
  $roles = \Drupal::service('entity_type.manager')
    ->getStorage('user_role')
    ->loadMultiple();

  $matched = [];
  $bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('block_content');
  foreach ($roles as $role_id => $role) {
    if ($role->hasPermission($permission)) {
      $role->revokePermission($permission);
      foreach ($bundles as $bundle_name => $bundle_info) {
        $settings = ContentLanguageSettings::loadByEntityTypeBundle('block_content', $bundle_name);
        $is_translatable = $settings->getThirdPartySetting('content_translation', 'enabled');
        if ($is_translatable) {
          $role->grantPermission('translate ' . $bundle_name . ' block_content');
        }
      }
      $role->save();
    }
  }
}
