<?php

/**
 * @file
 * Hooks and functionality for migration_provider_null_test.
 */

/**
 * Implements hook_migration_plugins_alter().
 */
function migration_provider_null_test_migration_plugins_alter(array &$definitions) {
  if (isset($definitions['d7_action'])) {
    $definitions['d7_action']['provider'] = NULL;
  }
}
