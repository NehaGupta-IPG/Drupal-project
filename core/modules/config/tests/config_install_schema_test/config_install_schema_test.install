<?php

/**
 * @file
 * Install function for the config_install_schema_test module.
 */

declare(strict_types=1);

use Drupal\Core\Database\SchemaDefinition\Column;
use Drupal\Core\Database\SchemaDefinition\Index;
use Drupal\Core\Database\SchemaDefinition\PrimaryKey;
use Drupal\Core\Database\SchemaDefinition\Schema;
use Drupal\Core\Database\SchemaDefinition\SchemaDefinitionType;
use Drupal\Core\Database\SchemaDefinition\StringValue;
use Drupal\Core\Database\SchemaDefinition\Table;

/**
 * Implements hook_schema().
 */
function config_install_schema_test_schema(): Schema {
  $tables[] = new Table(
    name: 'config_install_schema_test_ip',
    description: 'Stores banned IP addresses.',
    columns: [
      Column::serial(
        name: 'iid',
        description: 'Primary Key: unique ID for IP addresses.',
      ),
      Column::varcharAscii(
        name: 'ip',
        description: 'IP address',
        length: 40,
        notNull: TRUE,
        default: new StringValue(''),
      ),
    ],
    primaryKey: new PrimaryKey(['iid']),
    indexes: [
      new Index(name: 'ip', columns: ['ip']),
    ],
  );

  return new Schema(
    type: SchemaDefinitionType::Module,
    name: 'config_install_schema_test',
    tables: $tables,
  );
}
