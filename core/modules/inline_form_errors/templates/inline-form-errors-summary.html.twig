{#
/**
 * @file
 * Default theme implementation for the Inline Form Errors summary.
 *
 * Available variables:
 * - message: The lead line, example "3 errors have been found:".
 * - errors: A render array listing the errored elements.
 * - count: The integer number of errors. Useful for preprocess hooks or
 *   theme suggestions that vary the lead line by count.
 * - form_id: The form's machine ID; drives the template suggestion.
 *
 * @ingroup themeable
 */
#}
{{ message }}
{{ errors }}
