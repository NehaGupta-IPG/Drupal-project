{#
/**
 * @file
 * Default theme implementation for the Inline Form Errors summary.
 *
 * Available variables:
 * - error_links: A list of render arrays for the errored elements, one link
 *   per element.
 * - form_id: The form's machine ID; drives the theme suggestion
 *   inline_form_errors_summary__FORM_ID.
 *
 * @ingroup themeable
 */
#}
{% set count = error_links|length %}
{% trans %}
  {{ count }} error has been found:
{% plural count %}
  {{ count }} errors have been found:
{% endtrans %}
{% include 'item-list.html.twig' with {
  'items': error_links,
  'context': { 'list_style': 'comma-list' }
} %}
