<?php
function language_rebuild_b_test_uninstall() {
  $configs_to_delete = [
    'field.field.node.language_rebuild_a_test.field_field_b',
    'field.storage.node.field_field_b',
  ];

  foreach ($configs_to_delete as $config_id) {
    \Drupal::configFactory()->getEditable($config_id)->delete();
  }
}
