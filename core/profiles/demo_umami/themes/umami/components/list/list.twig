<div {{ attributes.addClass('umami-list') }}>
  <{{ html_tag|default('ul') }}>
    {% set items = items and items is not sequence ? [items] : items %}
    {% for item in items %}
      <li class="umami-list__item">
        {{ item }}
      </li>
    {% endfor %}
  </{{ html_tag|default('ul') }}>
</div>