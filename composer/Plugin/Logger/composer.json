{
  "name": "drupal/core-installer-log",
  "description": "Logs Composer package operations in a machine-readable format.",
  "keywords": ["drupal"],
  "homepage": "https://www.drupal.org/project/drupal",
  "license": "GPL-2.0-or-later",
  "type": "composer-plugin",
  "autoload": {
    "psr-4": {
      "Drupal\\Composer\\Plugin\\Logger\\": "."
    }
  },
  "extra": {
    "class": "Drupal\\Composer\\Plugin\\Logger\\Plugin"
  },
  "require": {
    "php": ">=8.3",
    "composer-plugin-api": "^2"
  }
}
