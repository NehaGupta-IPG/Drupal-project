# Drupal 11+ NGINX Example Configuration
# This is a starting point. Adjust paths, server_name, and PHP-FPM settings to match your environment.

server {
  listen 80;
  listen [::]:80;
  server_name example.com www.example.com;
  # Redirect HTTP to HTTPS
  return 301 https://example.com$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  # For HTTP/3 & QUIC (optional, uncomment if supported)
  # listen 443 quic;
  # listen [::]:443 quic;
  # http2 on;
  # http3 off;

  server_name example.com;
  # Change to your actual Drupal web root
  root /var/www/example.com/web; 

  # ssl_certificate /etc/ssl/certs/example.com.crt;
  # ssl_certificate_key /etc/ssl/private/example.com.key;

  index index.php index.html;

  # Upload limit for media (Fixes HTTP 413 errors)
  client_max_body_size 100M;

  # Security headers (Comment #33)
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  # Allow Let's Encrypt validation
  location ~ ^/.well-known/ {
    allow all;
  }

  # Block access to hidden files and directories (.git, .env, etc.)
  location ~ (^|/)\. {
    return 404;
  }

  # Protect sensitive files from prying eyes (Comment #24 & #27)
  location ~* \.(engine|inc|install|make|module|profile|po|sh|.*sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|composer\.(json|lock)|web\.config|yarn\.lock|package\.json$|^(\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template)$|^#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$ {
    deny all;
    return 404;
  }

  location / {
    try_files $uri /index.php?$query_string;
  }

  location @rewrite {
    rewrite ^ /index.php;
  }

  # Handle image styles generation
  location ~ ^/sites/.*/files/styles/ {
    try_files $uri @rewrite;
  }

  # Handle private files
  location ~ ^(/[a-z\-]+)?/system/files/ {
    try_files $uri /index.php?$query_string;
  }

  # Allow execution of specific PHP files only (Security best practice)
  location ~ ^\/(index|update|core\/(install|rebuild|authorize))\.php {
    fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
    # Ensure the file exists before passing to PHP-FPM
    try_files $fastcgi_script_name =404;
    
    # Use standard fastcgi_params
    include fastcgi_params;
    
    fastcgi_intercept_errors on;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_param HTTPS $fastcgi_https if_not_empty;
    fastcgi_read_timeout 3600;
    fastcgi_send_timeout 3600;
    
    # Point this to your PHP-FPM socket or IP:Port
    # fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    fastcgi_pass 127.0.0.1:9000;
  }

  # Block execution of any other PHP files
  location ~ \.php$ {
    return 404;
  }

  # Static assets cache and headers (Added webp and avif support)
  location ~* \.(css|js|jpg|jpeg|gif|png|ico|gz|svg|svgz|ttf|otf|woff|woff2|eot|mp4|ogg|ogv|webm|webp|avif|zip|swf)$ {
    add_header Access-Control-Allow-Origin "*";
    try_files $uri @rewrite;
    expires max;
    log_not_found off;
    access_log off;
  }
}
